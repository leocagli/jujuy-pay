# Copiar a .env. Todo es opcional: lo que falte corre en "modo demo" (pago simulado).

PORT=3000
# URL pública (túnel de cloudflared/ngrok). La necesitan Twilio, Mercado Pago y Stripe
# para volver a llamarnos y para mostrar la imagen del ticket en WhatsApp.
PUBLIC_URL=http://localhost:3000

# Clave del panel /admin (cambiala antes de mostrar el panel en público)
ADMIN_TOKEN=jujuy

# --- WhatsApp por Twilio Sandbox ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Mercado Pago (ARS): access token de PRUEBA (TEST-...) ---
MP_ACCESS_TOKEN=

# --- Stripe (tarjeta en USD/EUR/BRL/GBP): clave secreta de test (sk_test_...) ---
STRIPE_SECRET_KEY=

# --- USDC en Stellar ---
STELLAR_NETWORK=testnet
# Cuenta G... del comercio que recibe los USDC (con trustline a USDC)
STELLAR_MERCHANT_ADDRESS=
# USDC de Circle en testnet
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
