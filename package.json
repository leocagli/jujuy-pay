{
  "name": "jujuy-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Chatbot de WhatsApp para que turistas paguen pasajes, excursiones y eventos en Jujuy en cualquier moneda",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
